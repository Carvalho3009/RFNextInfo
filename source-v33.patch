+            last_sequence=MAX(last_sequence,COALESCE((SELECT MAX(sequence) FROM batches),0)) WHERE id=1""")
+        db.execute("DELETE FROM batches WHERE state='accepted'")
+    free = db.execute("PRAGMA freelist_count").fetchone()[0]
+    pages = db.execute("PRAGMA page_count").fetchone()[0]
+    # ponytail: compact once per upload run when at least 20% and 1 MiB are free.
+    page_size = db.execute("PRAGMA page_size").fetchone()[0]
+    if free * page_size >= 1024 * 1024 and free >= pages * 0.2:
+        db.execute("VACUUM")
