+    def sync_shopping_list(
+        self, installation_id: str, key_id: str, nonce: str, *,
+        nonce_retention_seconds: int, server_time: str,
+    ) -> dict[str, Any]:
+        """Read the linked owner's active shopping list; never execute purchases."""
+        now_ns = _now_ns()
+        cutoff_ns = now_ns - nonce_retention_seconds * 1_000_000_000
+        with self.session() as database:
+            database.execute("BEGIN IMMEDIATE")
+            installation = database.execute(
+                "SELECT key_id,status,owner_user_id FROM installations WHERE installation_id=?"
+                + (" FOR UPDATE" if self.is_postgres else ""),
+                (installation_id,),
+            ).fetchone()
+            if installation is None or installation["key_id"] != key_id:
+                raise ContractError("registration_required", "Instalação não registrada.")
+            if installation["status"] != "active":
+                raise ContractError("installation_not_active", "Instalação não autorizada.")
+            if installation["owner_user_id"] is None:
+                raise ContractError("pairing_required", "Vincule a instalação à sua conta no Companion.")
+            try:
+                database.execute(
+                    """INSERT INTO request_nonces
+                       (installation_id,key_id,nonce,seen_ns) VALUES(?,?,?,?)""",
+                    (installation_id, key_id, nonce, now_ns),
+                )
+            except INTEGRITY_ERRORS as error:
+                raise ContractError("replayed_request", "Nonce já utilizado.") from error
+            database.execute("DELETE FROM request_nonces WHERE seen_ns < ?", (cutoff_ns,))
+            rows = database.execute(
+                """SELECT shopping_id,item_index,item_name,enhance,
+                          quantity-COALESCE(bought_quantity,0) AS remaining_quantity,
+                          planned_unit_price,updated_ns
+                   FROM shopping_list_items
+                   WHERE user_id=? AND status='active'
+                     AND quantity>COALESCE(bought_quantity,0)
+                   ORDER BY priority,created_ns,shopping_id""",
+                (installation["owner_user_id"],),
+            ).fetchall()
+            items = [{
+                "shopping_id": str(row["shopping_id"]),
+                "item_index": int(row["item_index"]),
+                "name": str(row["item_name"]),
+                "enchant_level": int(row["enhance"]),
+                "remaining_quantity": int(row["remaining_quantity"]),
+                "reference_unit_price": (
+                    int(row["planned_unit_price"]) if row["planned_unit_price"] is not None else None
+                ),
+                "updated_at": (
+                    datetime.fromtimestamp(row["updated_ns"] / 1_000_000_000, timezone.utc).isoformat()
+                    if row["updated_ns"] is not None else None
+                ),
+            } for row in rows]
+            database.execute(
+                "UPDATE installations SET last_seen_ns=? WHERE installation_id=?",
+                (now_ns, installation_id),
+            )
+            database.commit()
+        return {
+            "schema": "rf-qol.shopping-sync/v1", "installation_id": installation_id,
+            "server_time": server_time, "items": items,
+        }
+
