 class ShellTests(unittest.TestCase):
+    def test_resize_callbacks_after_build_keep_their_widget(self):
+        Widget.all = []
+        app = self.make_app()
+        fake_ttk = SimpleNamespace(**{name: Widget for name in ("Frame Label LabelFrame Button Entry Combobox Checkbutton Notebook Treeview Scrollbar Progressbar Panedwindow").split()}, Style=lambda root: Mock())
+        with patch.object(shell, "ttk", fake_ttk), patch.object(shell.tk, "Canvas", Widget), patch.object(shell.tk, "StringVar", Variable), patch.object(shell.font, "families", return_value=("Segoe UI",)), patch.object(shell.font, "Font", side_effect=lambda **kw: Widget(**kw)):
+            shell.build(app)
+        profile_label = next(w for w in Widget.all if w.options.get("textvariable") is app.profile_label_var)
+        callbacks = [(w, w.bindings["<Configure>"]) for w in Widget.all if "<Configure>" in w.bindings]
+        self.assertGreater(len(callbacks), 10)
+        for width in (640, 40):
+            for widget, callback in callbacks:
+                callback(SimpleNamespace(widget=widget, width=width))
+            self.assertEqual(profile_label.options["wraplength"], max(80, width))
+
     def make_app(self):
         app = SimpleNamespace(root=Widget(), ui_font_size=14)
