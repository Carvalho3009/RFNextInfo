{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

(project_auth) {
	route {
		reverse_proxy /outpost.goauthentik.io/* authentik-server:9000
		forward_auth authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
		}
	}
}

:80 {
	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	@rooc_host host ragnarok.localhost ragnarok.karvalho.dev.br
	handle @rooc_host {
		import project_auth
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		reverse_proxy rooc:80
	}

	@rf_host host rfexp.localhost rfexp.karvalho.dev.br
	handle @rf_host {
		import project_auth
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		reverse_proxy rfnext:80 {
			header_up X-Karvalho-User {http.request.header.X-Authentik-Username}
			header_up -Cf-Access-Authenticated-User-Email
		}
	}

	@pokeidle_host host pokeidle.localhost pokeidle.karvalho.dev.br
	handle @pokeidle_host {
		import project_auth
		respond "PokeIdle em preparação." 200
	}

	@portal_host host localhost 127.0.0.1 karvalho.dev.br www.karvalho.dev.br
	handle @portal_host {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		reverse_proxy portal:80
	}

	@auth_host host auth.localhost auth.karvalho.dev.br
	handle @auth_host {
		reverse_proxy authentik-server:9000
	}

	respond 404
}
