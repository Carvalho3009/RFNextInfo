[Unit]
Description=Poke Idle Supervisor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=pokeidle
Group=pokeidle
WorkingDirectory=/opt/pokeidle
EnvironmentFile=/etc/pokeidle/pokeidle.env
Environment=POKEIDLE_CONFIG=/etc/pokeidle/config.yaml
ExecStart=/usr/bin/node /opt/pokeidle/dist/server/main.js
Restart=on-failure
RestartSec=20
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pokeidle
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
